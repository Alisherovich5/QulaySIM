{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "skipLibCheck": true,

    /* Bundler mode — Vite loads this config through esbuild, not Node's own
       resolver, and the prerender plugin imports app source (the locale files
       and src/lib/seo.ts) so that its copy cannot drift from the app's. Under
       "nodenext" those extensionless imports are errors, and satisfying it
       would mean writing ".js" extensions through application code that never
       goes near Node. "bundler" is what actually happens here. */
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["vite.config.ts"]
}
