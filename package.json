{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --force",
    "lint": "oxlint",
    "preview": "vite preview",
    "i18n:check": "node scripts/i18n-audit.mjs",
    "analyze": "ANALYZE=1 vite build",
    "size": "size-limit",
    "test": "vitest run",
    "layers": "node scripts/layers-audit.mjs",
    "verify": "npm run typecheck && npm run lint && npm run layers && npm run i18n:check && npm run test",
    "e2e": "playwright test",
    "serve:dist": "node scripts/serve-dist.mjs"
  },
  "dependencies": {
    "axios": "^1.18.1",
    "i18next": "^26.3.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^1.21.0",
    "prop-types": "^15.8.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-globe.gl": "^2.38.0",
    "react-i18next": "^17.0.8",
    "react-router-dom": "^7.18.0",
    "three": "^0.185.0",
    "topojson-client": "^3.1.0",
    "web-vitals": "^6.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@size-limit/file": "^13.0.3",
    "@tailwindcss/vite": "^4.3.1",
    "@types/d3-geo": "^3.1.0",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.0",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.10",
    "oxlint": "^1.69.0",
    "rollup-plugin-visualizer": "^7.1.1",
    "size-limit": "^13.0.3",
    "tailwindcss": "^4.3.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.0",
    "vitest": "^4.1.10"
  },
  "size-limit": [
    {
      "name": "birinchi yuklanish (landing)",
      "path": [
        "dist/assets/index-*.js",
        "dist/assets/index-*.css"
      ],
      "limit": "150 kB"
    },
    {
      "name": "globus (alohida, kech yuklanadi)",
      "path": "dist/assets/HeroGlobe-*.js",
      "limit": "40 kB"
    }
  ]
}
